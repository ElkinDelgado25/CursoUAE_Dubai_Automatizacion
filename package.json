{
  "name": "omp-playwright-harness",
  "version": "1.0.0",
  "description": "Automatización Playwright para ver las lecciones pendientes de https://omp.dub.ai",
  "scripts": {
    "login": "playwright test --project=setup",
    "ver": "node tools/ver-pendientes.mjs",
    "codegen": "playwright codegen https://omp.dub.ai",
    "typecheck": "tsc --noEmit",
    "install:browsers": "playwright install --with-deps chromium"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "dotenv": "^18.0.9",
    "typescript": "^7.0.2"
  },
  "private": true
}
